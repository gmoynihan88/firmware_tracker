# Firmware Tracker Configuration

# Anthropic API key for changelog summarization (optional)
ANTHROPIC_API_KEY=

# Debug mode (set to true for development)
DEBUG=false

# Database URL (default is SQLite)
DATABASE_URL=sqlite+aiosqlite:///./firmware_tracker.db

# Notification delivery (optional). "none" disables sending; notifications are
# still recorded and shown in the UI.
NOTIFY_TRANSPORT=none
# On public ntfy.sh the topic name is the only thing protecting your notifications.
# Use a long random value, e.g. firmware-tracker-$(openssl rand -hex 16).
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Scraping settings
SCRAPE_INTERVAL_HOURS=6
REQUEST_TIMEOUT=30
RATE_LIMIT_DELAY=1.0
