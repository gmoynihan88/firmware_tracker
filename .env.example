# Firmware Tracker Configuration

# Anthropic API key for changelog summarization (optional)
ANTHROPIC_API_KEY=

# Debug mode (set to true for development)
DEBUG=false

# Database URL (default is SQLite)
DATABASE_URL=sqlite+aiosqlite:///./firmware_tracker.db

# Authentication (optional, but required before exposing this app).
# Generate both values with: python -m src.auth.hash_password
AUTH_PASSWORD_HASH=
SECRET_KEY=
# Optional: lets scripts authenticate with an X-API-Key header instead of logging in.
API_KEY=
SESSION_LIFETIME_HOURS=336

# Notification delivery (optional). "none" disables sending; notifications are
# still recorded and shown in the UI.
NOTIFY_TRANSPORT=none
# On public ntfy.sh the topic name is the only thing protecting your notifications.
# Use a long random value, e.g. firmware-tracker-$(openssl rand -hex 16).
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Scraping settings
#
# Firmware ships a few times a year, so once a day already checks far more often
# than the data changes.
SCRAPE_INTERVAL_HOURS=24
REQUEST_TIMEOUT=30
RATE_LIMIT_DELAY=1.0

# Development only: cache scraped responses on disk so repeated debugging runs stop
# refetching from vendors. Leave off (or unset) anywhere real -- a cached run cannot
# discover a new firmware version.
SCRAPE_CACHE=false
SCRAPE_CACHE_TTL_HOURS=6

# Conditional requests: keep each page's ETag/Last-Modified and send it back, so an
# unchanged page answers 304 with no body. On by default. Only about a quarter of the
# tracked vendors send a validator, but for those it saves the whole page every run.
HTTP_REVALIDATE=true
