# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local
# Backups of .env hold the live ntfy topic, which is the only secret protecting
# notifications on public ntfy.sh. .env is ignored but .env.bak.* was not, so a
# `git add -A` would have staged one.
.env.bak.*
.env.*.bak

# Database
*.db
*.db-journal
*.sqlite
*.sqlite3
backups/

# Logs
*.log

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Development response cache (src/scrapers/cache.py)
.scrape_cache/

# Terraform. State holds every value the config touches, secrets included, and is
# kept in S3 rather than here. .tfvars carry the account-specific inputs -- account
# id, domain, the ntfy topic -- which is what keeps them out of a public repo.
infra/**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
# Names the state bucket, which is account-specific.
infra/backend.hcl
.terraform.lock.hcl.bak

# Claude Code local state: personal settings and scraper-batch progress
.claude/settings.local.json
.claude/batch.json
