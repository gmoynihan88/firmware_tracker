# Copy to terraform.tfvars, which is gitignored. Every value here has a default in
# variables.tf; this file exists so account-specific overrides have somewhere to live
# that is not the repository.

# alert_email has no default: a fresh clone cannot plan without it, which is
# deliberate -- cost alarms that go nowhere are worse than none. anomaly_monitor_arn
# names the AWS-managed monitor the account already has; leave it empty to skip the
# anomaly subscription entirely. Both are account-specific, which is why they live here
# rather than in variables.tf.
alert_email         = "you@example.com"
# anomaly_monitor_arn = "arn:aws:ce::<account>:anomalymonitor/<id>"
#   aws ce get-anomaly-monitors --query 'AnomalyMonitors[].MonitorArn' --output text

# project     = "firmware-tracker"
# environment = "production"
# region      = "us-west-2"
# vpc_cidr    = "10.20.0.0/16"

# A custom domain, if there is one. Both empty -- the default -- means no certificate and
# no DNS records, and CloudFront keeps serving its own *.cloudfront.net name, which is
# what a fork of this repository wants. The hosted zone is looked up rather than created:
# registering a domain through Route 53 already made one and pointed the nameservers at
# it, so declaring a second here would serve records nobody resolves.
# domain_name  = "example.dev"
# app_hostname = "firmware.example.dev"
